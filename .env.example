# ========================================================
# COMICCRAFT ENVIRONMENT
# ========================================================

APP_NAME=ComicCraft - AI Comic Story Creator


# ========================================================
# GEMINI
# ========================================================

GEMINI_API_KEY=

GEMINI_FLASH_MODEL=gemini-3.8-flash

GEMINI_PRO_MODEL=gemini-3.1-pro-preview


# ========================================================
# IMAGE GENERATION
# ========================================================

# Use placeholder first.
#
# placeholder = no GPU/model download
# diffusers   = real Stable Diffusion

IMAGE_PROVIDER=placeholder

IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5

HF_API_KEY=


# ========================================================
# IMAGE SETTINGS
# ========================================================

IMAGE_WIDTH=512

IMAGE_HEIGHT=512

IMAGE_STEPS=25

IMAGE_GUIDANCE=7.5


# ========================================================
# DEVELOPMENT
# ========================================================

# true = application works without Gemini key
# false = Gemini key required

ALLOW_MOCK_AI=true


# If Stable Diffusion fails,
# generate a placeholder instead.

ALLOW_IMAGE_FALLBACK=true


# Comic panel count

MAX_PANELS=5